{
  "manifest_version": 3,

  "name": "YouTube Judi Online Detector",

  "version": "1.0.0",

  "description": "Mendeteksi dan menyembunyikan komentar promosi judi online pada YouTube menggunakan IndoBERT.",

  "permissions": [],

  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "https://www.youtube.com/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Comment Filter"
  }
}